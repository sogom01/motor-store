---
const faqs = [
  { q:'¿Tienen repuestos para todas las marcas?', a:'Más de 8.000 referencias para Honda, Yamaha, Suzuki, Kawasaki, Bajaj, AKT, TVS y marcas chinas. Si no tenemos el repuesto en stock, lo conseguimos en 3–7 días hábiles.', open: true },
  { q:'¿Qué incluye el diagnóstico gratuito?', a:'Revisión visual completa, escaneo OBD2 (motos FI), verificación eléctrica básica, revisión de frenos, cadena y lubricación. Recibes un reporte escrito con cotización sin compromiso.' },
  { q:'¿Hacen envíos fuera de Manizales?', a:'Sí, enviamos a todo Colombia con Servientrega, Coordinadora y TCC. Pedidos pagos antes del mediodía salen el mismo día. Envío gratis en compras superiores a $150.000.' },
  { q:'¿Qué garantía tienen los trabajos del taller?', a:'Garantía escrita de 3 meses o 3.000 km en mano de obra y repuestos instalados. Si el problema reaparece, lo resolvemos sin costo adicional.' },
  { q:'¿Aceptan pago contra entrega?', a:'Sí, aceptamos pago contra entrega en ciudades principales, transferencia bancaria, Nequi y Daviplata. Para pedidos al taller puedes pagar al retirar tu moto.' },
  { q:'¿Cómo solicito una cotización?', a:'Usa el formulario de esta página y recibirás respuesta en menos de 2 horas (Lun–Sáb 8am–6pm), o visítanos directamente en Manizales.' },
];
---

<section id="faq" style="background: #F2F2F2; padding: 100px 5%;">
  <div class="max-w-[1400px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-14 lg:gap-20">

      <!-- Left sticky -->
      <div class="reveal-left lg:sticky lg:top-[90px] self-start">
        <p class="section-label" style="color:#F25C05;">Preguntas Frecuentes</p>
        <h2 class="section-title dark mt-2">TODO LO QUE<br>NECESITAS<br>SABER</h2>
        <p class="font-body leading-[1.75] mt-5 mb-6" style="color:#8A8A8A; font-size:0.95rem;">
          ¿Tienes dudas? Aquí resolvemos las más comunes. Si no encuentras tu respuesta, escríbenos.
        </p>

        <!-- Response stat -->
        <div class="p-5 mb-6" style="border: 1px solid #F25C05; background: rgba(242,92,5,0.04);">
          <div class="font-display text-[3rem] leading-none" style="color:#F25C05;">&lt;2h</div>
          <div class="font-condensed text-[0.72rem] tracking-widest uppercase mt-1" style="color:#8A8A8A;">Tiempo de respuesta</div>
        </div>

        <a href="#contacto" class="btn-primary inline-flex">Contáctanos</a>
      </div>

      <!-- Right accordion -->
      <div class="reveal-right flex flex-col" style="gap: 1px; background: #D8D8D8;">
        {faqs.map((f, i) => (
          <div class={`faq-item ${f.open ? 'open' : ''}`} style="background: #F2F2F2;">
            <button class="faq-question w-full flex items-center justify-between gap-4 py-6 px-1 text-left cursor-pointer"
                    style="background: transparent; border: none;"
                    onclick="toggleFaq(this)" aria-expanded={f.open ? 'true' : 'false'}>
              <span class="font-condensed text-[1rem] font-semibold leading-snug" style="color:#0D0D0D; letter-spacing:0.5px;">{f.q}</span>
              <span class="faq-icon flex-shrink-0 w-7 h-7 flex items-center justify-center text-[1rem] transition-all duration-300"
                    style="border: 1px solid #0D0D0D;">+</span>
            </button>
            <div class="faq-answer">
              <div class="font-body leading-[1.75] pb-6 px-1" style="color:#8A8A8A; font-size:0.93rem;">{f.a}</div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  function toggleFaq(btn: HTMLElement) {
    const item = btn.closest('.faq-item')!;
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach((i: Element) => {
      i.classList.remove('open');
      (i.querySelector('.faq-question') as HTMLElement)?.setAttribute('aria-expanded', 'false');
    });
    if (!isOpen) {
      item.classList.add('open');
      btn.setAttribute('aria-expanded', 'true');
    }
  }
  (window as any).toggleFaq = toggleFaq;
</script>
