---
const faqs = [
  { q:'¿Tienen repuestos para todas las marcas?', a:'Más de 8.000 referencias para Honda, Yamaha, Suzuki, Kawasaki, Bajaj, AKT, TVS y marcas chinas. Si no tenemos el repuesto en stock, lo conseguimos en 3–7 días hábiles.' },
  { q:'¿Qué incluye el diagnóstico gratuito?', a:'Revisión visual completa, escaneo OBD2 (motos FI), verificación eléctrica básica, revisión de frenos, cadena y lubricación. Recibes un reporte escrito con cotización sin compromiso.' },
  { q:'¿Hacen envíos fuera de Manizales?', a:'Sí, enviamos a todo Colombia con Servientrega, Coordinadora y TCC. Pedidos pagos antes del mediodía salen el mismo día. Envío gratis en compras superiores a $150.000.' },
  { q:'¿Qué garantía tienen los trabajos del taller?', a:'Garantía escrita de 3 meses o 3.000 km en mano de obra y repuestos instalados. Si el problema reaparece, lo resolvemos sin costo adicional.' },
  { q:'¿Cómo solicito una cotización?', a:'Usa el formulario de esta página y recibirás respuesta en menos de 2 horas (Lun–Sáb 8am–6pm), o visítanos directamente en Manizales.' },
];
---

<section id="faq" class="py-24 lg:py-32 bg-[#181208] relative">
  <div class="max-w-[1320px] mx-auto px-6 md:px-10">

    <div class="grid grid-cols-1 lg:grid-cols-[2fr_3fr] gap-16">

      <!-- Left -->
      <div class="reveal-left">
        <span class="tag-label mb-6 inline-flex">FAQ</span>
        <h2 class="font-display leading-[0.9] mb-8" style="font-size: clamp(2.5rem, 5vw, 4.5rem);">
          <span class="text-[#EDE5D8]">PREGUNTAS</span><br>
          <span style="color:#E8520A;">FRECUENTES</span>
        </h2>
        <p class="text-[0.875rem] leading-[1.75] text-[rgba(237,229,216,0.45)] mb-8">
          Todo lo que necesitas saber antes de visitarnos o hacer tu pedido.
        </p>
        <div class="border border-[rgba(232,82,10,0.25)] bg-[rgba(232,82,10,0.05)] p-5 mb-8">
          <div class="font-display text-[2.8rem] text-[#E8520A] leading-none mb-1">&lt;2h</div>
          <div class="text-[0.72rem] text-[rgba(237,229,216,0.45)]">Tiempo de respuesta en horario laboral</div>
        </div>
        <a href="#contacto" class="btn-outline" style="font-size:0.72rem; padding:0.7rem 1.5rem;">
          ¿Otra pregunta? Escríbenos
        </a>
      </div>

      <!-- Right: accordion -->
      <div class="reveal-right flex flex-col gap-px bg-[rgba(237,229,216,0.04)]">
        {faqs.map((f, i) => (
          <div class={`faq-item bg-[#181208] reveal d${i+1}`}>
            <button class="faq-question w-full flex items-center justify-between gap-4 px-6 py-5 text-left hover:bg-[rgba(237,229,216,0.02)] transition-colors" aria-expanded="false">
              <h3 class="text-[0.9rem] font-semibold text-[#EDE5D8] leading-snug">{f.q}</h3>
              <span class="faq-toggle w-7 h-7 border border-[rgba(232,82,10,0.25)] bg-[rgba(232,82,10,0.06)] flex items-center justify-center shrink-0 transition-all">
                <svg class="faq-icon w-3 h-3 transition-transform" viewBox="0 0 24 24" fill="none" stroke="#E8520A" stroke-width="2.5" stroke-linecap="round">
                  <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
              </span>
            </button>
            <div class="faq-answer">
              <div class="px-6 pb-5 text-[0.85rem] leading-[1.75] text-[rgba(237,229,216,0.5)] border-t border-[rgba(237,229,216,0.04)] pt-4">
                {f.a}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item')!;
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => { i.classList.remove('open'); i.querySelector('.faq-question')?.setAttribute('aria-expanded','false'); });
      if (!open) { item.classList.add('open'); btn.setAttribute('aria-expanded','true'); }
    });
  });
</script>
