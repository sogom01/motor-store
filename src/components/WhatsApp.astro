<!-- Tooltip label (shows on first load) -->
<div id="wa-tooltip"
     class="fixed bottom-[5.5rem] right-6 z-50 bg-[#080808] border border-[rgba(255,255,255,0.1)] text-white text-[0.72rem] font-bold tracking-wide px-4 py-2 whitespace-nowrap shadow-xl transition-all duration-500"
     style="opacity: 0; transform: translateY(6px);">
  💬 Escríbenos por WhatsApp
</div>

<script>
  const tooltip = document.getElementById('wa-tooltip')!;
  setTimeout(() => {
    tooltip.style.opacity = '1';
    tooltip.style.transform = 'translateY(0)';
    setTimeout(() => {
      tooltip.style.opacity = '0';
      tooltip.style.transform = 'translateY(6px)';
    }, 3500);
  }, 2500);
</script>
