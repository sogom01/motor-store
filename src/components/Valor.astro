---
---

<section id="valor" class="py-24 lg:py-32 bg-[#181208] relative overflow-hidden">
  <!-- Ambient glow -->
  <div class="absolute bottom-0 right-0 w-[600px] h-[400px] pointer-events-none"
       style="background: radial-gradient(ellipse at bottom right, rgba(232,82,10,0.07) 0%, transparent 65%);"></div>

  <div class="max-w-[1320px] mx-auto px-6 md:px-10 relative z-10">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">

      <!-- Left: Large stat block -->
      <div class="reveal-left">
        <span class="tag-label mb-6 inline-flex">Por qué elegirnos</span>

        <h2 class="font-display leading-[0.9] mb-10"
            style="font-size: clamp(3rem, 7vw, 6rem);">
          <span class="text-[#EDE5D8]">EL TALLER</span><br>
          <span style="color:#E8520A;">QUE SÍ</span><br>
          <span class="text-[#EDE5D8]">CUMPLE.</span>
        </h2>

        <!-- Big number feature -->
        <div class="grid grid-cols-2 gap-3">
          {[
            { n: '10+', l: 'Años de\nexperiencia' },
            { n: '3m',  l: 'Meses de\ngarantía' },
            { n: '8K',  l: 'Repuestos\nen stock' },
            { n: '2h',  l: 'Tiempo de\nrespuesta' },
          ].map(s => (
            <div class="border border-[rgba(237,229,216,0.07)] bg-[#100D08] p-5 hover:border-[rgba(232,82,10,0.25)] hover:bg-[#1C1308] transition-all group">
              <div class="font-display text-[3.5rem] leading-none text-[#E8520A] mb-1 group-hover:text-[#F06828] transition-colors">{s.n}</div>
              <div class="text-[0.68rem] font-medium tracking-[0.1em] uppercase text-[rgba(237,229,216,0.35)] whitespace-pre-line leading-tight">{s.l}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: feature list -->
      <div class="reveal-right">
        <div class="flex flex-col divide-y divide-[rgba(237,229,216,0.06)]">
          {[
            {
              icon: `<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>`,
              title: 'Inventario amplio',
              desc: 'Más de 8.000 referencias para todas las marcas del mercado colombiano. Originales y alternativos de calidad certificada.',
            },
            {
              icon: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>`,
              title: 'Diagnóstico electrónico',
              desc: 'Escáner OBD2 para motos FI y diagnóstico completo para motos carburadas. El problema identificado antes de abrir el motor.',
            },
            {
              icon: `<rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>`,
              title: 'Envío nacional',
              desc: 'Despachamos a cualquier ciudad. Empaque profesional, seguimiento en tiempo real. Gratis en compras +$150.000.',
            },
            {
              icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
              title: 'Garantía escrita',
              desc: '3 meses o 3.000 km en mano de obra y repuestos instalados. Si el problema vuelve, lo resolvemos sin costo.',
            },
          ].map((f, i) => (
            <div class={`group flex items-start gap-5 py-6 hover:bg-[rgba(232,82,10,0.03)] transition-colors reveal d${i+1}`}>
              <div class="w-10 h-10 border border-[rgba(232,82,10,0.2)] bg-[rgba(232,82,10,0.06)] flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-[rgba(232,82,10,0.12)] group-hover:border-[rgba(232,82,10,0.4)] transition-all">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E8520A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
              </div>
              <div>
                <h3 class="font-display text-[1.3rem] tracking-wide text-[#EDE5D8] mb-1">{f.title}</h3>
                <p class="text-[0.85rem] leading-relaxed text-[rgba(237,229,216,0.45)] group-hover:text-[rgba(237,229,216,0.6)] transition-colors">{f.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="pt-6">
          <a href="#contacto" class="btn-primary">Agendar servicio →</a>
        </div>
      </div>

    </div>
  </div>
</section>
