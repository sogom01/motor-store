---
const pasos = [
  { num:'01', title:'CUÉNTANOS', sub:'Qué necesita tu moto', desc:'Visítanos en Manizales o escríbenos. Dinos la marca, modelo, año y el problema o repuesto que buscas.' },
  { num:'02', title:'COTIZAMOS', sub:'En minutos, sin letra pequeña', desc:'Precio fijo, tiempo de entrega claro y diagnóstico gratuito si es taller. Apruebas antes de que toquemos nada.' },
  { num:'03', title:'LISTO',     sub:'Con garantía escrita', desc:'Retira en tienda o recibe en casa. Cada trabajo sale con garantía por escrito de 3 meses o 3.000 km.' },
];
---

<section id="servicios" class="py-24 lg:py-32 bg-[#080808] relative overflow-hidden">

  <!-- Ghost number background -->
  <div class="absolute right-[-2%] top-1/2 -translate-y-1/2 font-display leading-none text-[rgba(255,82,0,0.025)] pointer-events-none select-none"
       style="font-size: 35vw;">3</div>

  <!-- Top rule -->
  <div class="absolute top-0 left-0 right-0 h-px bg-[rgba(255,255,255,0.05)]"></div>

  <div class="max-w-[1320px] mx-auto px-6 md:px-10 relative z-10">

    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-16 reveal">
      <div>
        <span class="tag-label mb-5 inline-flex">Cómo trabajamos</span>
        <h2 class="font-display leading-[0.88]" style="font-size: clamp(2.8rem, 6vw, 5.5rem);">
          <span class="block text-white">ASÍ DE</span>
          <span class="block text-[#FF5200]">SIMPLE.</span>
        </h2>
      </div>
      <p class="text-[0.875rem] leading-[1.75] text-[rgba(255,255,255,0.38)] max-w-[360px]">
        Sin sorpresas en el precio, sin esperas indefinidas. Tres pasos y tu moto lista.
      </p>
    </div>

    <!-- Steps grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 border border-[rgba(255,255,255,0.07)]">
      {pasos.map((s, i) => (
        <div class={`group relative p-8 lg:p-10 bg-[#080808] hover:bg-[#111111] transition-colors reveal d${i+1}
          ${i < 2 ? 'border-b md:border-b-0 md:border-r border-[rgba(255,255,255,0.07)]' : ''}`}>

          <!-- Step indicator -->
          <div class="flex items-center gap-4 mb-10">
            <div class="w-11 h-11 bg-[#FF5200] text-white font-display text-[1.3rem] flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              {i + 1}
            </div>
            <div class="h-px flex-1 bg-gradient-to-r from-[rgba(255,82,0,0.4)] to-transparent"></div>
          </div>

          <p class="text-[0.6rem] font-bold tracking-[0.18em] uppercase text-[rgba(255,255,255,0.25)] mb-2">{s.sub}</p>
          <h3 class="font-display text-[2.4rem] tracking-wide text-white mb-3">{s.title}</h3>
          <p class="text-[0.85rem] leading-[1.7] text-[rgba(255,255,255,0.4)]">{s.desc}</p>

          <!-- Ghost bg num -->
          <div class="absolute bottom-4 right-5 font-display text-[6rem] leading-none text-[rgba(255,82,0,0.04)] group-hover:text-[rgba(255,82,0,0.08)] transition-colors select-none pointer-events-none">
            {s.num}
          </div>
        </div>
      ))}
    </div>

    <!-- CTA strip -->
    <div class="mt-3 flex flex-col sm:flex-row items-center justify-between gap-4 p-5 border border-[rgba(255,255,255,0.06)] bg-[#111111] reveal">
      <div class="flex items-center gap-3">
        <div class="w-2 h-2 bg-[#FF5200] pulse shrink-0"></div>
        <span class="text-[0.82rem] text-[rgba(255,255,255,0.45)]">Diagnóstico gratuito en tu primera visita al taller</span>
      </div>
      <a href="#contacto" class="btn-primary" style="padding:0.7rem 1.8rem; font-size:0.72rem;">
        Agendar diagnóstico
      </a>
    </div>

  </div>
</section>
