---
---

<section id="servicios" class="py-24 lg:py-32 bg-[#100D08] relative overflow-hidden">

  <!-- Ghost number -->
  <div class="absolute right-0 top-1/2 -translate-y-1/2 font-display text-[30vw] leading-none text-[rgba(232,82,10,0.03)] pointer-events-none select-none translate-x-8">3</div>

  <div class="max-w-[1320px] mx-auto px-6 md:px-10 relative z-10">

    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-16 reveal">
      <div>
        <span class="tag-label mb-4 inline-flex">Cómo trabajamos</span>
        <h2 class="font-display leading-[0.9]" style="font-size: clamp(2.8rem, 6vw, 5rem);">
          <span class="text-[#EDE5D8]">ASÍ DE</span><br>
          <span style="color:#E8520A;">SIMPLE.</span>
        </h2>
      </div>
      <p class="text-[0.875rem] leading-[1.75] text-[rgba(237,229,216,0.45)] max-w-[360px]">
        Sin sorpresas en el precio, sin esperas indefinidas. Tres pasos y tu moto lista.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border border-[rgba(237,229,216,0.06)]">
      {[
        { num:'01', title:'CUÉNTANOS', sub:'Qué necesita tu moto', desc:'Visítanos en Manizales o escríbenos. Dinos la marca, modelo, año y el problema o repuesto que buscas.' },
        { num:'02', title:'COTIZAMOS', sub:'En minutos, sin letra pequeña', desc:'Precio fijo, tiempo de entrega claro y diagnóstico gratuito si es taller. Apruebas antes de que toquemos nada.' },
        { num:'03', title:'LISTO',     sub:'Con garantía escrita', desc:'Retira en tienda o recibe en casa. Cada trabajo sale con garantía por escrito de 3 meses o 3.000 km.' },
      ].map((s, i) => (
        <div class={`group relative p-8 lg:p-10 bg-[#100D08] hover:bg-[#181208] transition-colors reveal d${i+1} ${i < 2 ? 'border-b md:border-b-0 md:border-r border-[rgba(237,229,216,0.06)]' : ''}`}>

          <!-- Step number -->
          <div class="flex items-center gap-4 mb-8">
            <div class="w-11 h-11 bg-[#E8520A] text-[#100D08] font-display text-[1.4rem] flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              {i + 1}
            </div>
            <div class="h-px flex-1 bg-gradient-to-r from-[rgba(232,82,10,0.4)] to-transparent"></div>
          </div>

          <p class="text-[0.62rem] font-bold tracking-[0.14em] uppercase text-[rgba(237,229,216,0.3)] mb-2">{s.sub}</p>
          <h3 class="font-display text-[2.4rem] tracking-wide text-[#EDE5D8] mb-3">{s.title}</h3>
          <p class="text-[0.85rem] leading-[1.7] text-[rgba(237,229,216,0.45)]">{s.desc}</p>

          <!-- Ghost bg num -->
          <div class="absolute bottom-4 right-4 font-display text-[6rem] leading-none text-[rgba(232,82,10,0.04)] group-hover:text-[rgba(232,82,10,0.07)] transition-colors select-none pointer-events-none">{s.num}</div>

        </div>
      ))}
    </div>

    <!-- CTA row -->
    <div class="mt-3 flex flex-col sm:flex-row items-center justify-between gap-4 p-6 border border-[rgba(237,229,216,0.05)] bg-[#141008] reveal">
      <div class="flex items-center gap-3">
        <div class="w-2 h-2 rounded-full bg-[#E8520A] pulse shrink-0"></div>
        <span class="text-[0.8rem] text-[rgba(237,229,216,0.5)]">Diagnóstico gratuito en tu primera visita al taller</span>
      </div>
      <a href="#contacto" class="btn-primary" style="padding:0.65rem 1.5rem; font-size:0.72rem;">
        Agendar diagnóstico
      </a>
    </div>

  </div>
</section>
