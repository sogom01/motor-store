---
---
<footer style="background: #080808; border-top: 1px solid #1E1E1E; padding: 4rem 5% 2rem;">

  <!-- Main grid -->
  <div class="max-w-[1400px] mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr] gap-12 pb-10"
       style="border-bottom: 1px solid #1E1E1E;">

    <!-- Brand -->
    <div>
      <a href="#inicio" class="font-display text-[2.2rem] tracking-[4px] text-white select-none block mb-4">
        MOTOR<span style="color:#F25C05;">STORE</span>
      </a>
      <p class="font-body font-light leading-[1.7] mb-6" style="color:#8A8A8A; font-size:0.875rem; max-width:280px;">
        Taller mecánico y tienda de repuestos en Manizales. Más de 15 años con los moteros de Colombia. Calidad real para riders reales.
      </p>
      <div class="flex gap-3">
        {[
          { label:'Instagram', href:'https://instagram.com/', icon:`<rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" fill="none" stroke="currentColor" stroke-width="2"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="currentColor" stroke-width="2"/>` },
          { label:'Facebook',  href:'https://facebook.com/', icon:`<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" fill="currentColor"/>` },
          { label:'TikTok',    href:'https://tiktok.com/',   icon:`<path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.89 2.89 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01A6.34 6.34 0 0 0 6.28 15.3a6.34 6.34 0 0 0 12.67 0V9.01a8.16 8.16 0 0 0 4.78 1.52V7.1a4.85 4.85 0 0 1-1.02-.41z" fill="currentColor"/>` },
        ].map(s => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}
             class="w-10 h-10 flex items-center justify-center transition-all"
             style="border: 1px solid #1E1E1E; color: #8A8A8A;"
             onmouseenter="this.style.background='#F25C05';this.style.borderColor='#F25C05';this.style.color='#fff';"
             onmouseleave="this.style.background='';this.style.borderColor='#1E1E1E';this.style.color='#8A8A8A';">
            <svg width="15" height="15" viewBox="0 0 24 24" set:html={s.icon} />
          </a>
        ))}
      </div>
    </div>

    <!-- Tienda -->
    <div>
      <h4 class="font-condensed text-[0.68rem] font-bold tracking-[4px] uppercase text-white mb-5">Tienda</h4>
      <ul class="flex flex-col gap-3 list-none">
        {['Motor & Transmisión','Frenos & Suspensión','Sistema Eléctrico','Carrocería & Plásticos','Filtros & Lubricantes','Accesorios'].map(i => (
          <li><a href="#catalogo" class="font-body text-[0.875rem] hover:text-[#F25C05] transition-colors" style="color:#8A8A8A;">{i}</a></li>
        ))}
      </ul>
    </div>

    <!-- Marca -->
    <div>
      <h4 class="font-condensed text-[0.68rem] font-bold tracking-[4px] uppercase text-white mb-5">Taller</h4>
      <ul class="flex flex-col gap-3 list-none">
        {['Mantenimiento','Diagnóstico','Reparación Motor','Sistema Frenos','Rev. Técnico-Mecánica','Tuning'].map(i => (
          <li><a href="#nosotros" class="font-body text-[0.875rem] hover:text-[#F25C05] transition-colors" style="color:#8A8A8A;">{i}</a></li>
        ))}
      </ul>
    </div>

    <!-- Ayuda -->
    <div>
      <h4 class="font-condensed text-[0.68rem] font-bold tracking-[4px] uppercase text-white mb-5">Ayuda</h4>
      <ul class="flex flex-col gap-3 list-none">
        {[['Preguntas Frecuentes','#faq'],['Garantías','#'],['Política de Devoluciones','#'],['Términos y Condiciones','#'],['Privacidad','#']].map(([l,h]) => (
          <li><a href={h} class="font-body text-[0.875rem] hover:text-[#F25C05] transition-colors" style="color:#8A8A8A;">{l}</a></li>
        ))}
      </ul>
      <div class="mt-6 pt-5" style="border-top: 1px solid #1E1E1E;">
        <p class="font-condensed text-[0.6rem] tracking-widest uppercase mb-1" style="color:#555;">Ubicación</p>
        <p class="font-body text-[0.82rem] leading-relaxed" style="color:#8A8A8A;">Manizales, Caldas<br>Lun–Sáb: 8am – 6pm</p>
      </div>
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="max-w-[1400px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 pt-6 flex-wrap">
    <p class="font-condensed text-[0.72rem] tracking-[2px] uppercase" style="color:#444;">
      © 2025 <span style="color:#F25C05;">MOTORSTORE</span> — Todos los derechos reservados
    </p>
    <p class="font-condensed text-[0.72rem] tracking-[2px] uppercase" style="color:#444;">
      Hecho con 🔧 para riders de verdad
    </p>
  </div>

</footer>
