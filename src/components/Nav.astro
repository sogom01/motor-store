---
const links = [
  { href: '#inicio',   label: 'Inicio'    },
  { href: '#catalogo', label: 'Tienda'    },
  { href: '#nosotros', label: 'Nosotros'  },
  { href: '#marcas',   label: 'Marcas'    },
  { href: '#faq',      label: 'FAQ'       },
  { href: '#contacto', label: 'Contacto'  },
];
---

<nav id="main-nav"
     class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-[5%] transition-all duration-300"
     style="height:70px; background: rgba(13,13,13,0.96); backdrop-filter: blur(14px); border-bottom: 1px solid #1E1E1E;">

  <!-- Logo -->
  <a href="#inicio" class="flex items-center gap-3 select-none" aria-label="Motor Store">
    <svg width="32" height="22" viewBox="0 0 64 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="shrink-0">
      <circle cx="12" cy="34" r="9"  stroke="#F25C05" stroke-width="3"/>
      <circle cx="12" cy="34" r="3"  fill="#F25C05"/>
      <circle cx="52" cy="34" r="9"  stroke="#F25C05" stroke-width="3"/>
      <circle cx="52" cy="34" r="3"  fill="#F25C05"/>
      <path d="M12 34 L22 14 L38 11 L52 34" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M24 14 L38 10 L42 20 L24 20 Z" fill="#F25C05"/>
      <line x1="46" y1="18" x2="56" y2="10" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
    </svg>
    <span class="font-display text-[1.7rem] tracking-[3px] text-white leading-none">
      MOTOR<span style="color:#F25C05;">STORE</span>
    </span>
  </a>

  <!-- Desktop links -->
  <ul class="hidden md:flex items-center gap-8 list-none">
    {links.slice(0, -1).map(l => (
      <li>
        <a href={l.href}
           data-nav-link
           class="nav-link font-condensed text-[0.82rem] font-semibold tracking-[0.14em] uppercase transition-colors relative"
           style="color:#6A6A6A;">
          {l.label}
          <span class="nav-underline absolute bottom-[-4px] left-0 h-px w-0 transition-all duration-300" style="background:#F25C05;"></span>
        </a>
      </li>
    ))}
  </ul>

  <!-- CTA desktop + hamburger móvil -->
  <div class="flex items-center gap-4">
    <a href="#contacto"
       class="hidden md:inline-flex items-center gap-2 font-condensed text-[0.78rem] font-bold tracking-[0.14em] uppercase px-5 py-2 transition-all"
       style="background:#F25C05; color:#fff;"
       onmouseenter="this.style.background='#C44A04';"
       onmouseleave="this.style.background='#F25C05';">
      Contacto
    </a>

    <!-- Hamburger — solo visible en móvil -->
    <button id="hamburger"
            class="md:hidden flex flex-col justify-center gap-[5px] w-8 h-8 bg-transparent border-none cursor-pointer z-[70] relative"
            aria-label="Abrir menú" aria-expanded="false">
      <span id="ham-1" class="block w-6 h-0.5 bg-white transition-all duration-300 origin-center"></span>
      <span id="ham-2" class="block w-6 h-0.5 bg-white transition-all duration-300"></span>
      <span id="ham-3" class="block w-6 h-0.5 bg-white transition-all duration-300 origin-center"></span>
    </button>
  </div>
</nav>

<!-- Mobile menu — z-[60] para estar sobre el nav (z-50) -->
<div id="mobile-menu"
     aria-hidden="true"
     style="
       position: fixed;
       inset: 0;
       z-index: 60;
       display: flex;
       flex-direction: column;
       align-items: flex-start;
       justify-content: center;
       padding: 0 10%;
       background: #0A0A0A;
       opacity: 0;
       pointer-events: none;
       transition: opacity 0.35s ease;
       overflow: hidden;
     ">

  <!-- Glow naranja decorativo de fondo -->
  <div style="
    position: absolute;
    top: -20%;
    right: -15%;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(242,92,5,0.12) 0%, transparent 70%);
    pointer-events: none;
  "></div>

  <!-- Línea naranja vertical izquierda -->
  <div id="menu-line" style="
    position: absolute;
    left: 0;
    top: 0;
    width: 3px;
    height: 0%;
    background: linear-gradient(to bottom, #F25C05, transparent);
    transition: height 0.6s cubic-bezier(0.4,0,0.2,1);
  "></div>

  <!-- Botón cerrar -->
  <button id="mobile-close"
          aria-label="Cerrar menú"
          style="
            position: absolute;
            top: 1.4rem; right: 6%;
            background: transparent;
            border: 1px solid #2A2A2A;
            color: #8A8A8A;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.2s;
            line-height: 1;
            padding: 0.55rem 0.75rem;
            letter-spacing: 1px;
          "
          onmouseenter="this.style.borderColor='#F25C05';this.style.color='#F25C05';"
          onmouseleave="this.style.borderColor='#2A2A2A';this.style.color='#8A8A8A';">
    ESC
  </button>

  <!-- Eyebrow label -->
  <p style="
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #F25C05;
    margin-bottom: 2.5rem;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease 0.05s, transform 0.4s ease 0.05s;
  " id="menu-eyebrow">— Navegación</p>

  <!-- Links con número decorativo -->
  {links.map((l, i) => (
    <div class="menu-link-wrap"
         style={`
           display: flex;
           align-items: baseline;
           gap: 1rem;
           opacity: 0;
           transform: translateX(-24px);
           transition: opacity 0.45s ease ${0.08 + i * 0.07}s, transform 0.45s ease ${0.08 + i * 0.07}s;
           margin-bottom: 0.1rem;
         `}>
      <span style="
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 2px;
        color: #F25C05;
        opacity: 0.7;
        min-width: 22px;
      ">0{i + 1}</span>
      <a href={l.href}
         class="menu-link font-display"
         style="
           font-size: clamp(2.2rem, 9vw, 3.8rem);
           text-decoration: none;
           color: #FFFFFF;
           letter-spacing: 3px;
           line-height: 1.15;
           position: relative;
           display: inline-block;
           transition: color 0.25s ease, transform 0.25s ease;
         "
         onmouseenter="
           this.style.color='#F25C05';
           this.style.transform='translateX(10px)';
           this.previousElementSibling.style.opacity='1';
           this.querySelector('.link-underline').style.width='100%';
         "
         onmouseleave="
           this.style.color='#FFFFFF';
           this.style.transform='translateX(0)';
           this.previousElementSibling.style.opacity='0.7';
           this.querySelector('.link-underline').style.width='0%';
         ">
        {l.label}
        <span class="link-underline" style="
          position: absolute;
          bottom: 2px;
          left: 0;
          height: 2px;
          width: 0%;
          background: #F25C05;
          transition: width 0.3s cubic-bezier(0.4,0,0.2,1);
          display: block;
        "></span>
      </a>
    </div>
  ))}

  <!-- Footer del menú -->
  <div style="
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease 0.55s, transform 0.4s ease 0.55s;
  " id="menu-footer">
    <p style="font-family:'Barlow Condensed',sans-serif; font-size:0.68rem; letter-spacing:0.25em; text-transform:uppercase; color:#444;">
      Manizales, Colombia
    </p>
    <p style="font-family:'Barlow Condensed',sans-serif; font-size:0.68rem; letter-spacing:0.25em; text-transform:uppercase; color:#444;">
      Lun – Sáb · 8am a 6pm
    </p>
  </div>

</div>

<script>
  const nav    = document.getElementById('main-nav')!;
  const burger = document.getElementById('hamburger')!;
  const menu   = document.getElementById('mobile-menu')!;
  const closeBtn = document.getElementById('mobile-close')!;
  const ham1   = document.getElementById('ham-1')!;
  const ham2   = document.getElementById('ham-2')!;
  const ham3   = document.getElementById('ham-3')!;

  let isOpen = false;

  const menuLine    = document.getElementById('menu-line')!;
  const menuEyebrow = document.getElementById('menu-eyebrow')!;
  const menuFooter  = document.getElementById('menu-footer')!;
  const menuWraps   = document.querySelectorAll<HTMLElement>('.menu-link-wrap');

  function openMenu() {
    isOpen = true;
    menu.style.opacity       = '1';
    menu.style.pointerEvents = 'auto';
    menu.setAttribute('aria-hidden', 'false');
    burger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    // Hamburguesa → X
    ham1.style.transform = 'translateY(7px) rotate(45deg)';
    ham2.style.opacity   = '0';
    ham3.style.transform = 'translateY(-7px) rotate(-45deg)';
    // Animar elementos internos
    menuLine.style.height = '100%';
    menuEyebrow.style.opacity   = '1';
    menuEyebrow.style.transform = 'translateY(0)';
    menuFooter.style.opacity    = '1';
    menuFooter.style.transform  = 'translateY(0)';
    menuWraps.forEach(w => {
      w.style.opacity   = '1';
      w.style.transform = 'translateX(0)';
    });
  }

  function closeMenu() {
    isOpen = false;
    menu.style.opacity       = '0';
    menu.style.pointerEvents = 'none';
    menu.setAttribute('aria-hidden', 'true');
    burger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    // Revertir hamburguesa
    ham1.style.transform = '';
    ham2.style.opacity   = '1';
    ham3.style.transform = '';
    // Resetear animaciones para la próxima apertura
    menuLine.style.height = '0%';
    menuEyebrow.style.opacity   = '0';
    menuEyebrow.style.transform = 'translateY(10px)';
    menuFooter.style.opacity    = '0';
    menuFooter.style.transform  = 'translateY(10px)';
    menuWraps.forEach(w => {
      w.style.opacity   = '0';
      w.style.transform = 'translateX(-24px)';
    });
  }

  burger.addEventListener('click', () => isOpen ? closeMenu() : openMenu());
  closeBtn.addEventListener('click', closeMenu);

  // Cerrar al hacer clic en cualquier link del menú
  document.querySelectorAll('.menu-link').forEach(link => {
    link.addEventListener('click', () => {
      closeMenu();
    });
  });

  // ── Smooth scroll para TODOS los links de ancla ──
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('a[href^="#"]') as HTMLAnchorElement | null;
    if (!target) return;
    const dest = document.querySelector(target.getAttribute('href')!);
    if (!dest) return;
    e.preventDefault();
    const top = (dest as HTMLElement).getBoundingClientRect().top + window.scrollY - nav.offsetHeight - 8;
    window.scrollTo({ top, behavior: 'smooth' });
  });

  // ── Nav scroll activo ──
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('a[data-nav-link]');

  function setActive(id: string) {
    navLinks.forEach(a => {
      const active = a.getAttribute('href') === `#${id}`;
      a.style.color = active ? '#FFFFFF' : '#6A6A6A';
      const u = a.querySelector('.nav-underline') as HTMLElement | null;
      if (u) u.style.width = active ? '100%' : '0';
    });
  }

  const sectionObs = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) setActive((e.target as HTMLElement).id); }),
    { rootMargin: '-40% 0px -50% 0px' }
  );
  sections.forEach(s => sectionObs.observe(s));

  // ── Sombra en scroll ──
  window.addEventListener('scroll', () => {
    nav.style.boxShadow = window.scrollY > 30 ? '0 4px 30px rgba(0,0,0,0.5)' : 'none';
  }, { passive: true });
</script>
