---
const stats = [
  { n: '+8.000', l: 'Repuestos' },
  { n: '+15',    l: 'Años de exp.' },
  { n: '3 meses',l: 'Garantía' },
  { n: '5★',     l: 'Calificación' },
];
---

<section id="inicio" class="relative min-h-screen flex items-center overflow-hidden pt-[70px]"
         style="background: #0D0D0D;">

  <!-- Grid lines background -->
  <div class="absolute inset-0 pointer-events-none" style="
    background:
      radial-gradient(ellipse 60% 50% at 70% 50%, rgba(242,92,5,0.11) 0%, transparent 70%),
      repeating-linear-gradient(90deg, transparent, transparent 60px, rgba(255,255,255,0.014) 60px, rgba(255,255,255,0.014) 61px),
      repeating-linear-gradient(0deg,  transparent, transparent 60px, rgba(255,255,255,0.014) 60px, rgba(255,255,255,0.014) 61px);
  "></div>

  <!-- Noise texture -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.035]"
       style="background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E\"); background-size: 200px;"></div>

  <!-- Content -->
  <div class="relative z-10 w-full max-w-[1400px] mx-auto px-[5%] py-20">

    <!-- Eyebrow -->
    <p class="u1 section-label" style="color: #F25C05;">
      Taller &amp; Repuestos · Manizales, Caldas
    </p>

    <!-- Headline -->
    <h1 class="u2 font-display leading-[0.88] tracking-[2px] mt-4 mb-6"
        style="font-size: clamp(4rem, 13vw, 10.5rem);">
      <span class="block text-white">TU MOTO</span>
      <span class="block text-outline">SIEMPRE</span>
      <span class="block" style="color: #F25C05;">LISTA.</span>
    </h1>

    <!-- Sub -->
    <p class="u3 font-body text-[1.05rem] font-light leading-[1.75]"
       style="color: #8A8A8A; max-width: 460px; margin-bottom: 2.5rem;">
      Más de 8.000 repuestos en stock para todas las marcas. Mecánicos certificados,
      diagnóstico electrónico y envíos a toda Colombia.
    </p>

    <!-- CTAs -->
    <div class="u4 flex flex-wrap gap-4 mb-20">
      <a href="#catalogo" class="btn-primary">
        Explorar Tienda
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a href="#nosotros" class="btn-secondary">Conocer el Taller</a>
    </div>

    <!-- Stats -->
    <div class="u5 flex flex-wrap gap-10 pt-8" style="border-top: 1px solid #1E1E1E;">
      {stats.map(s => (
        <div>
          <div class="font-display text-[2.6rem] leading-none" style="color: #F25C05; letter-spacing: 1px;">{s.n}</div>
          <div class="font-condensed text-[0.72rem] font-medium tracking-[0.18em] uppercase mt-1" style="color: #8A8A8A;">{s.l}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 right-[5%] flex flex-col items-center gap-2"
       style="color: #8A8A8A; font-family: 'Barlow Condensed', sans-serif; font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase; writing-mode: vertical-rl;">
    <div class="scroll-line w-px h-16" style="background: linear-gradient(to bottom, #F25C05, transparent);"></div>
    Scroll
  </div>

</section>
