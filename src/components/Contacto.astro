---
---

<section id="contacto" class="py-24 lg:py-32 bg-[#100D08] relative overflow-hidden">
  <!-- Warm glow -->
  <div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(to right, transparent, #E8520A 30%, rgba(232,82,10,0.2) 70%, transparent);"></div>
  <div class="absolute top-0 left-0 w-[500px] h-[500px] pointer-events-none"
       style="background: radial-gradient(ellipse at top left, rgba(232,82,10,0.08) 0%, transparent 65%);"></div>

  <!-- Bg text -->
  <div class="absolute right-[-3rem] bottom-[-1rem] font-display text-[20vw] leading-none text-[rgba(232,82,10,0.04)] pointer-events-none select-none tracking-tighter">
    STORE
  </div>

  <div class="max-w-[1320px] mx-auto px-6 md:px-10 relative z-10">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

      <!-- Left -->
      <div class="reveal-left">
        <span class="tag-label mb-6 inline-flex">Contáctanos</span>
        <h2 class="font-display leading-[0.9] mb-6" style="font-size: clamp(3rem, 7vw, 6rem);">
          <span class="text-[#EDE5D8]">¿LISTO PARA</span><br>
          <span style="color:#E8520A;">RODAR?</span>
        </h2>
        <p class="text-[0.9rem] leading-[1.8] text-[rgba(237,229,216,0.5)] mb-10 max-w-[400px]">
          Escríbenos y te respondemos en menos de 2 horas. Repuestos disponibles hoy, taller disponible esta semana.
        </p>

        <div class="flex flex-col gap-4">
          {[
            { label:'Ubicación', val:'Manizales, Caldas · Colombia', icon:`<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>` },
            { label:'Horario', val:'Lunes – Sábado, 8:00am – 6:00pm', icon:`<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>` },
            { label:'Respuesta', val:'Menos de 2 horas en horario laboral', icon:`<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>` },
          ].map(item => (
            <div class="flex items-start gap-4 border border-[rgba(237,229,216,0.06)] bg-[#181208] p-4 hover:border-[rgba(232,82,10,0.2)] hover:bg-[#1C1308] transition-all group">
              <div class="w-8 h-8 border border-[rgba(232,82,10,0.25)] bg-[rgba(232,82,10,0.06)] flex items-center justify-center shrink-0">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#E8520A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
              </div>
              <div>
                <p class="text-[0.62rem] font-bold tracking-widest uppercase text-[rgba(237,229,216,0.28)] mb-0.5">{item.label}</p>
                <p class="text-[0.85rem] text-[#EDE5D8] font-medium">{item.val}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: form -->
      <div class="reveal-right">
        <div class="border border-[rgba(237,229,216,0.08)] bg-[#181208] p-8 lg:p-10 relative">
          <div class="absolute top-0 left-0 w-12 h-0.5 bg-[#E8520A]"></div>

          <div class="flex items-center gap-2 mb-8">
            <div class="w-1.5 h-1.5 bg-[#E8520A] pulse"></div>
            <span class="font-display text-[1.4rem] tracking-wide text-[#EDE5D8]">Solicita tu cotización</span>
          </div>

          <form id="contact-form" novalidate class="flex flex-col gap-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <input type="text" name="nombre" placeholder="Tu nombre" aria-label="Nombre" required autocomplete="name"
                class="w-full px-4 py-3.5 bg-[rgba(237,229,216,0.04)] border border-[rgba(237,229,216,0.08)] text-[0.875rem] text-[#EDE5D8] placeholder-[rgba(237,229,216,0.25)] outline-none focus:bg-[rgba(232,82,10,0.04)] focus:border-[rgba(232,82,10,0.35)] transition-all" />
              <input type="email" name="email" placeholder="Tu correo" aria-label="Email" required autocomplete="email"
                class="w-full px-4 py-3.5 bg-[rgba(237,229,216,0.04)] border border-[rgba(237,229,216,0.08)] text-[0.875rem] text-[#EDE5D8] placeholder-[rgba(237,229,216,0.25)] outline-none focus:bg-[rgba(232,82,10,0.04)] focus:border-[rgba(232,82,10,0.35)] transition-all" />
            </div>

            <input type="text" name="moto" placeholder="Marca y modelo de tu moto (ej: Honda CB 190, 2020)" aria-label="Moto"
              class="w-full px-4 py-3.5 bg-[rgba(237,229,216,0.04)] border border-[rgba(237,229,216,0.08)] text-[0.875rem] text-[#EDE5D8] placeholder-[rgba(237,229,216,0.25)] outline-none focus:bg-[rgba(232,82,10,0.04)] focus:border-[rgba(232,82,10,0.35)] transition-all" />

            <div class="relative">
              <select name="servicio" aria-label="Servicio" required
                class="w-full px-4 py-3.5 bg-[rgba(237,229,216,0.04)] border border-[rgba(237,229,216,0.08)] text-[0.875rem] text-[rgba(237,229,216,0.6)] outline-none focus:bg-[rgba(232,82,10,0.04)] focus:border-[rgba(232,82,10,0.35)] appearance-none cursor-pointer transition-all">
                <option value="" disabled selected>¿Qué necesitas?</option>
                <option value="repuesto">Compra de repuesto</option>
                <option value="mantenimiento">Mantenimiento preventivo</option>
                <option value="reparacion">Reparación / diagnóstico</option>
                <option value="revision">Revisión técnico-mecánica</option>
                <option value="otro">Otro</option>
              </select>
              <svg class="absolute right-4 top-1/2 -translate-y-1/2 w-3 h-3 pointer-events-none" viewBox="0 0 12 8" fill="none">
                <path d="M1 1l5 5 5-5" stroke="rgba(237,229,216,0.35)" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>

            <textarea name="mensaje" placeholder="Cuéntanos más (opcional)…" rows="3" aria-label="Mensaje"
              class="w-full px-4 py-3.5 bg-[rgba(237,229,216,0.04)] border border-[rgba(237,229,216,0.08)] text-[0.875rem] text-[#EDE5D8] placeholder-[rgba(237,229,216,0.25)] outline-none focus:bg-[rgba(232,82,10,0.04)] focus:border-[rgba(232,82,10,0.35)] resize-none transition-all"></textarea>

            <input type="text" name="_gotcha" class="hidden" aria-hidden="true" tabindex="-1" autocomplete="off" />

            <button type="submit" id="submit-btn" class="btn-primary w-full justify-center">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
              Enviar cotización gratis
            </button>

            <p id="form-feedback" class="text-center text-[0.78rem] font-medium hidden"></p>
            <p class="text-center text-[0.65rem] text-[rgba(237,229,216,0.2)]">Respuesta en menos de 2 horas en horario laboral.</p>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btn  = document.getElementById('submit-btn') as HTMLButtonElement;
  const fb   = document.getElementById('form-feedback') as HTMLElement;

  form.addEventListener('submit', async e => {
    e.preventDefault();
    if ((form.querySelector('[name="_gotcha"]') as HTMLInputElement)?.value) return;

    const nombre   = (form.querySelector('[name="nombre"]') as HTMLInputElement)?.value.trim();
    const email    = (form.querySelector('[name="email"]') as HTMLInputElement)?.value.trim();
    const servicio = (form.querySelector('[name="servicio"]') as HTMLSelectElement)?.value;

    if (!nombre || !email || !servicio) { show('Completa los campos obligatorios.', false); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { show('Correo inválido.', false); return; }

    btn.disabled = true; btn.textContent = 'Enviando…';
    await new Promise(r => setTimeout(r, 900));
    show('¡Cotización enviada! Te contactamos pronto.', true);
    form.reset(); btn.textContent = '✓ Enviado';
    setTimeout(() => { btn.disabled = false; btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Enviar cotización gratis`; }, 4000);
  });

  function show(msg: string, ok: boolean) {
    fb.textContent = msg;
    fb.className = `text-center text-[0.78rem] font-medium ${ok ? 'text-[#E8520A]' : 'text-red-400'}`;
    fb.classList.remove('hidden');
  }
</script>
