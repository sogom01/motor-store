---
const detalles = [
  { icon: '📧', label: 'Correo',     val: 'hola@motorstore.co',          path: `<circle cx="12" cy="12" r="10"/><polyline points="8 12 12 16 16 12"/><line x1="12" y1="8" x2="12" y2="16"/>` },
  { icon: '📱', label: 'WhatsApp',   val: '+57 310 000 0000',             path: '' },
  { icon: '📍', label: 'Ubicación',  val: 'Manizales, Caldas · Colombia', path: '' },
  { icon: '🕐', label: 'Horario',    val: 'Lun – Sáb · 8am a 6pm',       path: '' },
];
---

<section id="contacto" class="sec" style="background: #0D0D0D;">
  <div class="max-w-[1400px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.6fr] gap-14 lg:gap-20 items-start">

      <!-- Left: info -->
      <div class="reveal-left">
        <p class="section-label" style="color:#F25C05;">Escríbenos</p>
        <h2 class="section-title light mt-2">ESTAMOS<br>PARA<br>AYUDARTE</h2>

        <div class="flex flex-col gap-4 mt-8">
          {detalles.map(d => (
            <div class="flex items-start gap-4">
              <div class="w-11 h-11 flex items-center justify-center text-lg flex-shrink-0"
                   style="border: 1px solid #1E1E1E; color: #F25C05;">
                {d.icon}
              </div>
              <div>
                <p class="font-condensed text-[0.68rem] font-bold tracking-[3px] uppercase mb-1" style="color:#8A8A8A;">{d.label}</p>
                <p class="font-condensed text-[1rem] font-medium" style="color:#FFFFFF;">{d.val}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Socials -->
        <div class="flex gap-3 mt-8">
          {[
            { label: 'Instagram', href: 'https://instagram.com/', icon: `<rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" fill="none" stroke="currentColor" stroke-width="2"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="currentColor" stroke-width="2"/>` },
            { label: 'Facebook',  href: 'https://facebook.com/', icon: `<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" fill="currentColor"/>` },
            { label: 'TikTok',    href: 'https://tiktok.com/',   icon: `<path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.89 2.89 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01A6.34 6.34 0 0 0 6.28 15.3a6.34 6.34 0 0 0 12.67 0V9.01a8.16 8.16 0 0 0 4.78 1.52V7.1a4.85 4.85 0 0 1-1.02-.41z" fill="currentColor"/>` },
          ].map(s => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}
               class="w-11 h-11 flex items-center justify-center transition-all hover:scale-105"
               style="border: 1px solid #1E1E1E; color: #8A8A8A;"
               onmouseenter="this.style.background='#F25C05';this.style.borderColor='#F25C05';this.style.color='#fff';"
               onmouseleave="this.style.background='';this.style.borderColor='#1E1E1E';this.style.color='#8A8A8A';">
              <svg width="16" height="16" viewBox="0 0 24 24" set:html={s.icon} />
            </a>
          ))}
        </div>
      </div>

      <!-- Right: form -->
      <div class="reveal-right">
        <form id="contact-form" novalidate class="flex flex-col gap-4">

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-2">
              <label class="font-condensed text-[0.68rem] font-bold tracking-[3px] uppercase" style="color:#8A8A8A;">Nombre</label>
              <input type="text" name="nombre" placeholder="Tu nombre completo" required autocomplete="name" class="form-input" />
            </div>
            <div class="flex flex-col gap-2">
              <label class="font-condensed text-[0.68rem] font-bold tracking-[3px] uppercase" style="color:#8A8A8A;">Correo</label>
              <input type="email" name="email" placeholder="tu@correo.com" required autocomplete="email" class="form-input" />
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label class="font-condensed text-[0.68rem] font-bold tracking-[3px] uppercase" style="color:#8A8A8A;">Moto</label>
            <input type="text" name="moto" placeholder="Marca, modelo y año (ej: Honda CB 190, 2021)" class="form-input" />
          </div>

          <div class="flex flex-col gap-2">
            <label class="font-condensed text-[0.68rem] font-bold tracking-[3px] uppercase" style="color:#8A8A8A;">Asunto</label>
            <select name="servicio" required class="form-input cursor-pointer" style="color: #8A8A8A;">
              <option value="" disabled selected>Selecciona un tema...</option>
              <option value="repuesto">Compra de repuesto</option>
              <option value="mantenimiento">Mantenimiento preventivo</option>
              <option value="reparacion">Reparación / diagnóstico</option>
              <option value="revision">Revisión técnico-mecánica</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <div class="flex flex-col gap-2">
            <label class="font-condensed text-[0.68rem] font-bold tracking-[3px] uppercase" style="color:#8A8A8A;">Mensaje</label>
            <textarea name="mensaje" placeholder="Cuéntanos en qué podemos ayudarte..." rows="4" class="form-input" style="resize: vertical;"></textarea>
          </div>

          <input type="text" name="_gotcha" class="hidden" aria-hidden="true" tabindex="-1" autocomplete="off" />

          <button type="submit" id="submit-btn" class="form-submit mt-2">
            Enviar Mensaje →
          </button>

          <p id="form-feedback" class="hidden text-center font-condensed text-[0.82rem] font-semibold tracking-wide"></p>
          <p class="text-center font-condensed text-[0.65rem] tracking-widest uppercase" style="color:#555;">
            Respuesta en menos de 2 horas en horario laboral.
          </p>
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btn  = document.getElementById('submit-btn') as HTMLButtonElement;
  const fb   = document.getElementById('form-feedback') as HTMLElement;

  form.addEventListener('submit', async e => {
    e.preventDefault();
    if ((form.querySelector('[name="_gotcha"]') as HTMLInputElement)?.value) return;

    const nombre   = (form.querySelector('[name="nombre"]')  as HTMLInputElement)?.value.trim();
    const email    = (form.querySelector('[name="email"]')   as HTMLInputElement)?.value.trim();
    const servicio = (form.querySelector('[name="servicio"]') as HTMLSelectElement)?.value;

    if (!nombre || !email || !servicio) { show('Completa los campos obligatorios.', false); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { show('Correo inválido.', false); return; }

    btn.disabled = true; btn.textContent = 'Enviando…';
    await new Promise(r => setTimeout(r, 900));
    show('¡Mensaje enviado! Te contactamos pronto.', true);
    form.reset(); btn.textContent = '✓ Enviado';
    setTimeout(() => { btn.disabled = false; btn.textContent = 'Enviar Mensaje →'; }, 4000);
  });

  function show(msg: string, ok: boolean) {
    fb.textContent = msg;
    fb.style.color = ok ? '#F25C05' : '#ef4444';
    fb.classList.remove('hidden');
  }
</script>
