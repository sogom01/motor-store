---
/* 5 categorías → primera tall (rowspan 2) + 4 normales */
const categorias = [
  {
    slug: 'motor', name: 'Motor &\nTransmisión', refs: '+1.200 Productos',
    img: '/images/motor.jpg',
    bg: 'linear-gradient(135deg, #0f0f2e 0%, #151540 50%, #0a1060 100%)',
    tall: true,
  },
  {
    slug: 'frenos', name: 'Frenos &\nSuspensión', refs: '+900 Productos',
    img: '/images/frenos.jpg',
    bg: 'linear-gradient(135deg, #1a1205 0%, #2d1f00 50%, #3d2800 100%)',
    tall: false,
  },
  {
    slug: 'electrico', name: 'Sistema\nEléctrico', refs: '+1.500 Productos',
    img: '/images/Cableado.jpg',
    bg: 'linear-gradient(135deg, #0d1b0d 0%, #1a2e1a 50%, #122212 100%)',
    tall: false,
  },
  {
    slug: 'carroceria', name: 'Carrocería\n& Plásticos', refs: '+800 Productos',
    img: '/images/Carenados.jpg',
    bg: 'linear-gradient(135deg, #1a0505 0%, #2e0d0d 50%, #3d1212 100%)',
    tall: false,
  },
  {
    slug: 'accesorios', name: 'Accesorios\n& Tuning', refs: '+2.000 Productos',
    img: '/images/cascos.jpg',
    bg: 'linear-gradient(135deg, #050d1a 0%, #0d1a2e 50%, #0a1540 100%)',
    tall: false,
  },
];

const productos = [
  {
    brand: 'Yuasa',
    name: 'Batería YTZ7S 12V — Honda / Yamaha / Suzuki',
    price: '$185.000',
    badge: 'Más vendido',
    badgeDark: false,
    img: '/images/bateria.jpg',
    bg: 'linear-gradient(135deg, #1a1a1a, #2d2d2d)',
  },
  {
    brand: 'Brembo',
    name: 'Pastillas de Freno OE Delantera — Motos Sport',
    price: '$78.000',
    badge: 'Nuevo',
    badgeDark: false,
    img: '/images/pastillas.jpg',
    bg: 'linear-gradient(135deg, #f5ece0, #ede0cc)',
  },
  {
    brand: 'Motul',
    name: 'Aceite 4T 10W-40 Technosynthese 1L',
    price: '$65.000',
    badge: '',
    badgeDark: false,
    img: '/images/aceite.jpg',
    bg: 'linear-gradient(135deg, #e8f0f5, #d0e0ed)',
  },
  {
    brand: 'NGK',
    name: 'Bujía Iridium IX BR9EIX — Alta Performance',
    price: '$42.000',
    badge: '-15%',
    badgeDark: true,
    img: '/images/bugia.jpg',
    bg: 'linear-gradient(135deg, #f0f0f0, #e0e0e0)',
  },
];
---

<section id="catalogo" class="section-responsive" style="background: #F2F2F2;">
  <div class="max-w-[1400px] mx-auto">

    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14 reveal">
      <div>
        <p class="section-label" style="color:#F25C05;">Catálogo</p>
        <h2 class="section-title dark">EXPLORA POR<br>CATEGORÍA</h2>
      </div>
      <a href="#contacto" class="btn-primary self-start lg:self-end">Consultar →</a>
    </div>

    <!-- Category grid: 3 cols desktop, 2 tablet, 1 mobile. Primera carta tall solo en desktop -->
    <div class="cats-grid">

      <!-- Tall first card -->
      <a href="#contacto"
         class="cat-card cats-tall reveal d1"
         style="aspect-ratio: 4/3;">
        <div class="cat-bg" style={`background-image: url('${categorias[0].img}'); background-size: cover; background-position: center; background-color: #1a1a2e;`}></div>
        <div class="cat-overlay"></div>
        <div class="cat-info">
          <div class="cat-name" style="white-space: pre-line;">{categorias[0].name}</div>
          <div class="cat-count">{categorias[0].refs}</div>
        </div>
        <div class="cat-arrow">→</div>
      </a>

      <!-- Other 4 cards -->
      {categorias.slice(1).map((cat, i) => (
        <a href="#contacto"
           class={`cat-card reveal d${i + 2}`}
           style="aspect-ratio: 4/3;">
          <div class="cat-bg" style={`background-image: url('${cat.img}'); background-size: cover; background-position: center; background-color: #1a1a1a;`}></div>
          <div class="cat-overlay"></div>
          <div class="cat-info">
            <div class="cat-name" style="white-space: pre-line;">{cat.name}</div>
            <div class="cat-count">{cat.refs}</div>
          </div>
          <div class="cat-arrow">→</div>
        </a>
      ))}
    </div>

    <!-- Productos destacados -->
    <div class="mt-20">
      <p class="section-label reveal" style="color:#F25C05;">Lo Más Vendido</p>
      <h2 class="section-title dark reveal">PRODUCTOS<br>DESTACADOS</h2>

      <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(260px,1fr)); gap: 2rem; margin-top: 3rem;">
        {productos.map((p, i) => (
          <div class={`product-card reveal d${i + 1}`}>

            <!-- Image area -->
            <div class="relative" style="aspect-ratio: 4/3; overflow: hidden;">
              <img
                src={p.img}
                alt={p.name}
                loading="lazy"
                style={`width:100%; height:100%; object-fit:cover; display:block; background: ${p.bg};`}
                onerror={`this.style.display='none'; this.parentElement.style.background='${p.bg}'; this.parentElement.classList.add('flex','items-center','justify-center'); this.parentElement.innerHTML='<span style="font-size:4rem">' + (i===0?'🔋':i===1?'🔴':i===2?'🛢️':'⚡') + '</span>';`}
              />
              {p.badge && (
                <span class="absolute top-3 left-3 font-condensed text-[0.62rem] font-bold tracking-[2px] uppercase text-white px-2.5 py-1"
                      style={`background: ${p.badgeDark ? '#0D0D0D' : '#F25C05'};`}>
                  {p.badge}
                </span>
              )}
            </div>

            <!-- Info -->
            <div style="padding: 1.2rem 1.5rem 1.5rem;">
              <p class="font-condensed text-[0.68rem] font-bold tracking-[3px] uppercase mb-1" style="color:#F25C05;">{p.brand}</p>
              <p class="font-condensed text-[1.1rem] font-semibold leading-snug" style="color:#0D0D0D;">{p.name}</p>

              <div class="flex items-center justify-between mt-4 pt-4" style="border-top: 1px solid #F0F0F0;">
                <div>
                  <div class="font-display text-[1.6rem] tracking-wide" style="color:#0D0D0D; letter-spacing: 1px;">{p.price}</div>
                  <div class="font-condensed text-[0.72rem] font-medium tracking-wide" style="color:#8A8A8A; letter-spacing: 1px;">COP · IVA incluido</div>
                </div>
                <button
                   class="w-10 h-10 flex items-center justify-center text-white font-bold transition-all open-modal"
                   data-img={p.img}
                   data-brand={p.brand}
                   data-name={p.name}
                   data-price={p.price}
                   style="background:#0D0D0D; font-size:1.2rem; border:none; cursor:pointer;"
                   title="Ver detalle"
                   onmouseenter="this.style.background='#F25C05'; this.style.transform='scale(1.1)';"
                   onmouseleave="this.style.background='#0D0D0D'; this.style.transform='scale(1)';">
                  +
                </button>
              </div>
            </div>

          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  /* ── Section padding responsive ── */
  .section-responsive { padding: 70px 5%; }
  @media (min-width: 1024px) { .section-responsive { padding: 100px 5%; } }

  /* ── Category grid responsive ── */
  .cats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5px;
  }
  .cats-tall { aspect-ratio: 4/3 !important; grid-row: span 1; }

  @media (min-width: 640px) {
    .cats-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .cats-grid { grid-template-columns: repeat(3, 1fr); min-height: 480px; }
    .cats-tall { grid-row: span 2 !important; aspect-ratio: auto !important; }
  }
</style>

<!-- Modal de producto -->
<div id="product-modal"
     role="dialog" aria-modal="true" aria-label="Detalle del producto"
     style="
       position: fixed; inset: 0; z-index: 200;
       display: flex; align-items: center; justify-content: center;
       background: rgba(0,0,0,0.82); backdrop-filter: blur(6px);
       opacity: 0; pointer-events: none;
       transition: opacity 0.3s;
       padding: 1.5rem;
     ">
  <div id="modal-box"
       style="
         background: #111111;
         border: 1px solid #2A2A2A;
         max-width: 540px; width: 100%;
         transform: translateY(20px);
         transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1);
         overflow: hidden;
       ">

    <!-- Imagen -->
    <div style="position:relative; aspect-ratio:4/3; background:#1A1A1A; overflow:hidden;">
      <img id="modal-img" src="" alt="" style="width:100%; height:100%; object-fit:cover; display:block;"/>
      <button id="modal-close"
              aria-label="Cerrar"
              style="
                position:absolute; top:1rem; right:1rem;
                background: rgba(0,0,0,0.7); border: 1px solid #333;
                color: white; width:36px; height:36px;
                display:flex; align-items:center; justify-content:center;
                cursor:pointer; font-size:1.1rem; transition: background 0.2s;
              "
              onmouseenter="this.style.background='#F25C05'; this.style.borderColor='#F25C05';"
              onmouseleave="this.style.background='rgba(0,0,0,0.7)'; this.style.borderColor='#333';">
        ✕
      </button>
    </div>

    <!-- Info -->
    <div style="padding: 1.8rem 2rem 2rem;">
      <p id="modal-brand" class="font-condensed text-[0.68rem] font-bold tracking-[3px] uppercase mb-1" style="color:#F25C05;"></p>
      <h3 id="modal-name" class="font-condensed text-[1.4rem] font-semibold leading-snug text-white mb-4"></h3>

      <div style="display:flex; align-items:flex-end; justify-content:space-between; padding-top:1.2rem; border-top: 1px solid #2A2A2A;">
        <div>
          <p id="modal-price" class="font-display text-[2rem] leading-none" style="color:#F25C05;"></p>
          <p class="font-condensed text-[0.72rem] tracking-wide mt-1" style="color:#555;">COP · IVA incluido</p>
        </div>
        <a href="#contacto" id="modal-cta" class="btn-primary" onclick="document.getElementById('product-modal').style.opacity='0'; document.getElementById('product-modal').style.pointerEvents='none'; document.getElementById('modal-box').style.transform='translateY(20px)';">
          Consultar disponibilidad →
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const modal    = document.getElementById('product-modal')!;
  const box      = document.getElementById('modal-box')!;
  const closeBtn = document.getElementById('modal-close')!;

  function openModal(img: string, brand: string, name: string, price: string) {
    (document.getElementById('modal-img')   as HTMLImageElement).src       = img;
    (document.getElementById('modal-img')   as HTMLImageElement).alt       = name;
    (document.getElementById('modal-brand') as HTMLElement).textContent    = brand;
    (document.getElementById('modal-name')  as HTMLElement).textContent    = name;
    (document.getElementById('modal-price') as HTMLElement).textContent    = price;
    modal.style.opacity       = '1';
    modal.style.pointerEvents = 'auto';
    box.style.transform       = 'translateY(0)';
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.style.opacity       = '0';
    modal.style.pointerEvents = 'none';
    box.style.transform       = 'translateY(20px)';
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.open-modal').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      openModal(
        el.dataset.img   || '',
        el.dataset.brand || '',
        el.dataset.name  || '',
        el.dataset.price || ''
      );
    });
  });

  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
</script>
