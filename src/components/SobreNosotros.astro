---
const valores = [
  { icon: '🔩', title: 'Calidad Real',    desc: 'Solo repuestos originales y alternativos con certificado de origen verificado.' },
  { icon: '🚚', title: 'Envío Rápido',    desc: 'Despacho el mismo día a todo Colombia con seguimiento en tiempo real.' },
  { icon: '🎯', title: 'Diagnóstico',     desc: 'Escáner OBD2 para motos FI y diagnóstico completo sin costo adicional.' },
  { icon: '🛡', title: 'Garantía Escrita', desc: '3 meses o 3.000 km en mano de obra. Por escrito, sin letra pequeña.' },
];
---

<section id="nosotros" class="sobre-section" style="background: #0D0D0D; position: relative; overflow: hidden;">
  <div class="max-w-[1400px] mx-auto">
    <div class="sobre-grid">

      <!-- Left -->
      <div class="reveal-left">
        <p class="section-label" style="color:#F25C05;">Quiénes Somos</p>

        <h2 class="font-display leading-[0.95] tracking-wide mt-3 mb-6"
            style="font-size: clamp(3rem, 7vw, 6rem); letter-spacing: 1px;">
          <span class="block text-white">NACIDOS</span>
          <span class="block" style="-webkit-text-stroke: 1px rgba(255,255,255,0.25); color: transparent;">PARA</span>
          <span class="block" style="color: #F25C05;">LA RUTA</span>
        </h2>

        <p class="font-body font-light leading-[1.8] mb-4" style="color:#8A8A8A; font-size:1rem; max-width:500px;">
          En Motor Store somos más que un taller — somos moteros que entienden lo que tu moto necesita. Cada repuesto en nuestro inventario fue seleccionado con un criterio simple: ¿lo usaríamos nosotros mismos?
        </p>
        <p class="font-body font-light leading-[1.8] mb-8" style="color:#8A8A8A; font-size:1rem; max-width:500px;">
          15 años atendiendo a los riders de Manizales y toda Colombia. Diagnóstico honesto, precio justo y garantía real. Así de simple.
        </p>

        <a href="#contacto" class="btn-primary inline-flex mb-10">
          Habla con Nosotros
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>

        <!-- Values grid -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2.5rem;">
          {valores.map((v, i) => (
            <div class={`hover:border-[#F25C05] transition-colors reveal d${i+1}`}
                 style="border: 1px solid #1E1E1E; padding: 1.2rem; transition: border-color 0.3s;">
              <div style="font-size: 1.5rem; margin-bottom: 8px;">{v.icon}</div>
              <div class="font-condensed text-[0.85rem] font-bold tracking-[2px] uppercase text-white mb-1">{v.title}</div>
              <div class="font-body text-[0.8rem] leading-[1.5]" style="color:#8A8A8A;">{v.desc}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: visual panel (oculto en móvil y tablet) -->
      <div class="reveal-right sobre-right-panel" style="position: relative;">
        <div style="position: relative; overflow: hidden; aspect-ratio: 3/4; background: #2A2A2A; display: flex; align-items: center; justify-content: center;">
          <!-- Imagen del taller — pon tu foto en /public/images/taller.jpg -->
          <img
            src="/images/interior.jpg"
            alt="Taller Motor Store Manizales"
            loading="lazy"
            style="width:100%; height:100%; object-fit:cover; position:absolute; inset:0;"
            onerror="this.style.display='none';"
          />
          <!-- Placeholder si no hay imagen -->
          <div style="font-size: 11rem; opacity: 0.07; position: relative; z-index: 1;">🏍️</div>

          <!-- Floating stat badge -->
          <div style="position: absolute; bottom: -20px; left: -20px; background: #F25C05; padding: 2rem; width: 170px; z-index: 10;">
            <div class="font-display text-white" style="font-size: 3rem; line-height: 1;">15+</div>
            <div class="font-condensed font-semibold tracking-[2px] uppercase leading-snug mt-1"
                 style="color: rgba(255,255,255,0.82); font-size: 0.7rem;">
              Años con los<br>moteros de Colombia
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .sobre-section { padding: 70px 5%; }
  .sobre-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  .sobre-right-panel { display: none; }

  @media (min-width: 1024px) {
    .sobre-section { padding: 100px 5%; }
    .sobre-grid { grid-template-columns: 1fr 1fr; gap: 6rem; }
    .sobre-right-panel { display: block; }
  }
</style>
