---
const testimonios = [
  {
    nombre: 'Andrés Mejía',
    ciudad: 'Manizales',
    moto:   'Honda CB 190R',
    texto:  'Llevé mi moto con un problema de encendido que otros talleres no habían podido resolver. En Motor Store lo diagnosticaron en minutos con el escáner OBD2 y en 2 horas ya estaba lista. Precio justo y garantía escrita.',
    stars:  5,
    inicial: 'A',
    bg: '#0f2a42',
  },
  {
    nombre: 'Valentina Ríos',
    ciudad: 'Pereira',
    moto:   'Yamaha FZ 2.0',
    texto:  'Pedí los frenos por WhatsApp a las 9am y los tenía en casa antes de las 6pm. Repuestos originales, bien empacados y con factura. El mejor servicio de repuestos que he encontrado en el eje cafetero.',
    stars:  5,
    inicial: 'V',
    bg: '#2a0f42',
  },
  {
    nombre: 'Carlos Zuluaga',
    ciudad: 'Armenia',
    moto:   'Bajaj Pulsar NS200',
    texto:  'La revisión técnico-mecánica incluye un reporte detallado por escrito. Aproveché y cambié el aceite y el filtro. Todo en menos de 3 horas. La atención es honesta, sin intentar cobrar cosas innecesarias.',
    stars:  5,
    inicial: 'C',
    bg: '#0f2a18',
  },
  {
    nombre: 'Laura Gómez',
    ciudad: 'Manizales',
    moto:   'AKT TT 150',
    texto:  'Me explicaron todo sin apresurarse. Me mostraron cada repuesto que cambiaron y me enseñaron a revisar el nivel de aceite yo misma. Ese trato diferenciado es difícil de encontrar en cualquier taller.',
    stars:  5,
    inicial: 'L',
    bg: '#42100f',
  },
];
---

<section id="testimonios" class="sec" style="background: #0D0D0D;">
  <div class="max-w-[1400px] mx-auto">

    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14 reveal">
      <div>
        <p class="section-label" style="color:#F25C05;">Testimonios</p>
        <h2 class="section-title light">LO QUE DICEN<br>NUESTROS RIDERS</h2>
      </div>
      <!-- Rating global -->
      <div class="flex items-center gap-3 self-start lg:self-end pb-1 reveal">
        <div class="font-display text-[3.5rem] leading-none" style="color:#F25C05;">4.9</div>
        <div>
          <div class="flex gap-1 mb-1">
            {[1,2,3,4,5].map(() => (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#F25C05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
          </div>
          <div class="font-condensed text-[0.68rem] tracking-widest uppercase" style="color:#555;">+200 reseñas verificadas</div>
        </div>
      </div>
    </div>

    <!-- Grid de tarjetas -->
    <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(280px,1fr)); gap: 1.5px; background: #1A1A1A;">
      {testimonios.map((t, i) => (
        <article
          class={`reveal d${i+1}`}
          style="background: #111111; padding: 2rem; cursor: default; transition: background 0.3s;"
          onmouseenter="this.style.background='#161616';"
          onmouseleave="this.style.background='#111111';">

          <!-- Stars -->
          <div class="flex gap-1 mb-5">
            {Array.from({length: t.stars}).map(() => (
              <svg width="13" height="13" viewBox="0 0 24 24" fill="#F25C05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
          </div>

          <!-- Comilla decorativa -->
          <div class="font-display text-[6rem] leading-[0.6] mb-2 select-none pointer-events-none" style="color: rgba(242,92,5,0.08);">"</div>

          <!-- Texto -->
          <p class="font-body font-light leading-[1.75] mb-6" style="color:#8A8A8A; font-size:0.92rem;">
            {t.texto}
          </p>

          <!-- Autor -->
          <div class="flex items-center gap-3 pt-5" style="border-top: 1px solid #1E1E1E;">
            <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 font-display text-[1.1rem] text-white"
                 style={`background: ${t.bg};`}>
              {t.inicial}
            </div>
            <div>
              <div class="font-condensed text-[0.9rem] font-semibold tracking-wide text-white">{t.nombre}</div>
              <div class="font-condensed text-[0.68rem] tracking-[2px] uppercase" style="color:#F25C05;">{t.moto} · {t.ciudad}</div>
            </div>
          </div>

        </article>
      ))}
    </div>

    <!-- CTA inferior -->
    <p class="text-center font-condensed text-[0.78rem] tracking-widest uppercase mt-6 reveal" style="color:#555;">
      Más de 500 clientes satisfechos cada mes ·
      <a href="#contacto" style="color:#F25C05;" onmouseenter="this.style.textDecoration='underline';" onmouseleave="this.style.textDecoration='none';">Únete →</a>
    </p>

  </div>
</section>
