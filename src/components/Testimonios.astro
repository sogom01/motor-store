---
const items = [
  { initials:'CA', name:'Carlos Andrade', city:'Manizales', rating:5,
    text:'Llevé mi Yamaha MT con un problema que en otros talleres no lograban diagnosticar. En 20 minutos ya sabían exactamente qué era. Trabajo perfecto y a mitad de precio.' },
  { initials:'LP', name:'Laura Patiño', city:'Pereira', rating:5,
    text:'Busqué un repuesto para mi Bajaj Pulsar que "no había en Colombia". Me lo consiguieron en 3 días y lo enviaron hasta Pereira perfectamente empacado. Increíble.' },
  { initials:'RG', name:'Ricardo Guerrero', city:'Manizales', rating:5,
    text:'Tengo 6 motos de domicilios. Motor Store me las mantiene al día con precios preferenciales. Nunca he tenido una moto parada más de un día.' },
];
---

<section id="testimonios" class="py-24 lg:py-32 bg-[#181208] relative">
  <div class="max-w-[1320px] mx-auto px-6 md:px-10">

    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-14 reveal">
      <div>
        <span class="tag-label mb-4 inline-flex">Testimonios</span>
        <h2 class="font-display leading-[0.9]" style="font-size: clamp(2.5rem, 5vw, 4.5rem);">
          <span class="text-[#EDE5D8]">CLIENTES QUE</span><br>
          <span style="color:#E8520A;">VUELVEN.</span>
        </h2>
      </div>
      <div class="flex items-center gap-2">
        {[...Array(5)].map(() => <span class="text-[#E8520A] text-xl">★</span>)}
        <span class="ml-2 text-[0.75rem] text-[rgba(237,229,216,0.4)] font-medium">5.0 · Google Reviews</span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {items.map((t, i) => (
        <div class={`group border border-[rgba(237,229,216,0.07)] bg-[#100D08] p-7 hover:border-[rgba(232,82,10,0.25)] hover:bg-[#141008] transition-all reveal d${i+1}`}>
          <div class="flex gap-0.5 mb-4">
            {[...Array(t.rating)].map(() => <span class="text-[#E8520A] text-sm">★</span>)}
          </div>
          <p class="text-[0.875rem] leading-[1.75] text-[rgba(237,229,216,0.65)] italic mb-6">"{t.text}"</p>
          <div class="flex items-center gap-3 pt-4 border-t border-[rgba(237,229,216,0.06)]">
            <div class="w-9 h-9 bg-[rgba(232,82,10,0.12)] border border-[rgba(232,82,10,0.25)] flex items-center justify-center font-display text-[1rem] text-[#E8520A] shrink-0">
              {t.initials}
            </div>
            <div>
              <div class="text-[0.85rem] font-bold text-[#EDE5D8]">{t.name}</div>
              <div class="text-[0.7rem] text-[rgba(237,229,216,0.3)]">{t.city}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
