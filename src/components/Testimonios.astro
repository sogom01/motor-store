---
const items = [
  { initials:'CA', name:'Carlos Andrade', city:'Manizales', rating:5,
    text:'Llevé mi Yamaha MT con un problema que en otros talleres no lograban diagnosticar. En 20 minutos ya sabían exactamente qué era. Trabajo perfecto y a mitad de precio.' },
  { initials:'LP', name:'Laura Patiño', city:'Pereira', rating:5,
    text:'Busqué un repuesto para mi Bajaj Pulsar que "no había en Colombia". Me lo consiguieron en 3 días y lo enviaron hasta Pereira perfectamente empacado. Increíble.' },
  { initials:'RG', name:'Ricardo Guerrero', city:'Manizales', rating:5,
    text:'Tengo 6 motos de domicilios. Motor Store me las mantiene al día con precios preferenciales. Nunca he tenido una moto parada más de un día.' },
];
---

<section id="testimonios" class="py-24 lg:py-32 bg-[#111111] relative overflow-hidden">

  <!-- Accent glow -->
  <div class="absolute bottom-0 left-0 w-[500px] h-[400px] pointer-events-none"
       style="background: radial-gradient(ellipse at bottom left, rgba(255,82,0,0.06) 0%, transparent 65%);"></div>

  <div class="max-w-[1320px] mx-auto px-6 md:px-10 relative z-10">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-14 reveal">
      <div>
        <span class="tag-label mb-5 inline-flex">Testimonios</span>
        <h2 class="font-display leading-[0.88]" style="font-size: clamp(2.5rem, 5.5vw, 5rem);">
          <span class="block text-white">CLIENTES QUE</span>
          <span class="block text-[#FF5200]">VUELVEN.</span>
        </h2>
      </div>
      <div class="flex items-center gap-3 pb-2">
        <div class="flex gap-0.5">
          {[...Array(5)].map(() => <span class="text-[#FF5200] text-lg">★</span>)}
        </div>
        <div>
          <div class="text-white font-bold text-[0.85rem]">5.0</div>
          <div class="text-[0.65rem] text-[rgba(255,255,255,0.35)] tracking-wider uppercase">Google Reviews</div>
        </div>
      </div>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      {items.map((t, i) => (
        <div class={`group relative border border-[rgba(255,255,255,0.07)] bg-[#080808] p-8 hover:border-[rgba(255,82,0,0.3)] hover:bg-[#0e0e0e] transition-all overflow-hidden reveal d${i+1}`}>

          <!-- Quote mark bg -->
          <div class="absolute top-4 right-5 font-display text-[8rem] leading-none text-[rgba(255,82,0,0.04)] select-none pointer-events-none group-hover:text-[rgba(255,82,0,0.07)] transition-colors">"</div>

          <!-- Stars -->
          <div class="flex gap-0.5 mb-5">
            {[...Array(t.rating)].map(() => <span class="text-[#FF5200] text-sm">★</span>)}
          </div>

          <!-- Text -->
          <p class="text-[0.875rem] leading-[1.8] text-[rgba(255,255,255,0.6)] mb-8 relative z-10">
            "{t.text}"
          </p>

          <!-- Author -->
          <div class="flex items-center gap-3 pt-5 border-t border-[rgba(255,255,255,0.06)]">
            <div class="w-10 h-10 bg-[rgba(255,82,0,0.1)] border border-[rgba(255,82,0,0.3)] flex items-center justify-center font-display text-[1rem] text-[#FF5200] shrink-0 group-hover:bg-[rgba(255,82,0,0.18)] transition-all">
              {t.initials}
            </div>
            <div>
              <div class="text-[0.85rem] font-bold text-white">{t.name}</div>
              <div class="text-[0.68rem] text-[rgba(255,255,255,0.3)] tracking-wide">{t.city}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="mt-10 text-center reveal">
      <p class="text-[0.82rem] text-[rgba(255,255,255,0.35)] mb-5">
        Más de 500 clientes satisfechos cada mes en Manizales y toda Colombia
      </p>
      <a href="#contacto" class="btn-outline" style="font-size:0.75rem; padding:0.85rem 2rem;">
        Únete a nuestros clientes →
      </a>
    </div>

  </div>
</section>
