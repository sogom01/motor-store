---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Catalogo from '../components/Catalogo.astro';
import SobreNosotros from '../components/SobreNosotros.astro';
import Marcas from '../components/Marcas.astro';
import FAQ from '../components/FAQ.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import WhatsApp from '../components/WhatsApp.astro';
---

<Base>
  <Nav />
  <main>
    <Hero />
    <Marquee />
    <Catalogo />
    <SobreNosotros />
    <Marcas />
    <FAQ />
    <Contacto />
  </main>
  <Footer />
  <ScrollReveal />
  <WhatsApp />
</Base>
