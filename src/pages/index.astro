---
import Base from '../layouts/Base.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Catalogo from '../components/Catalogo.astro';
import Valor from '../components/Valor.astro';
import Proceso from '../components/Proceso.astro';
import Testimonios from '../components/Testimonios.astro';
import Destacado from '../components/Destacado.astro';
import FAQ from '../components/FAQ.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
---

<Base>
  <div class="announcement-bar">
    <AnnouncementBar />
  </div>
  <Nav />
  <main>
    <Hero />
    <Catalogo />
    <Valor />
    <Proceso />
    <Testimonios />
    <Destacado />
    <FAQ />
    <Contacto />
  </main>
  <Footer />
  <ScrollReveal />
</Base>
